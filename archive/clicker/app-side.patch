+/* ---------------- clicker ----------------
+   A two-button HID keyboard (see clicker/) sends the same arrows the desktop
+   keys do, so it needs no protocol and no pairing app. The link is one-way:
+   a press that arrives while the app is backgrounded or the screen has slept
+   is gone, unnoticed. Hence the wake lock, and hence the blip. */
+
+// Best-effort only - absent on iOS < 16.4 and on file:// in some browsers, and
+// the app must behave exactly as before wherever it is missing. The lock is
+// dropped by the browser on hide anyway; the release handler lets us re-take it.
+// This runs on every tap, so it must be cheap: one request in flight at a time,
+// and a refusal is remembered until the next foreground rather than re-asked
+// thousands of times across a night.
+let wake = null, wakePending = false, wakeDenied = false;
+function holdWake() {
+  if (wake || wakePending || wakeDenied || document.hidden || !navigator.wakeLock) return;
+  wakePending = true;
+  navigator.wakeLock.request('screen').then(w => {
+    wakePending = false; wake = w;
+    w.addEventListener('release', () => { wake = null; });
+  }).catch(() => { wakePending = false; wakeDenied = true; });
+}
+function dropWake() {
+  try { if (wake) wake.release(); } catch {}
+  wake = null; wakeDenied = false;          // worth asking again on the next foreground
+}
+
+// iOS keeps audio silent until a real gesture opens the context; the first pad
+// tap or key press does it, and starting an event is a screen interaction anyway.
+let ac = null;
+function unlockAudio() {
+  try {
+    ac = ac || new (window.AudioContext || window.webkitAudioContext)();
+    if (ac.state === 'suspended') ac.resume();
+  } catch {}
+}
+// The only proof a clicker press landed: the motor in the hand says "pressed",
+// this says "counted". Four sounds, tellable apart in the dark without looking -
+// high in, low out, a falling pair for undo, and a floor tone for nothing to
+// undo. Every clicker key answers with one of them, so silence never means
+// anything but "not receiving".
+const BLIP_IN = [880], BLIP_OUT = [494], BLIP_UNDO = [740, 370], BLIP_NONE = [200];
+function blip(hz) {
+  unlockAudio();
+  if (!ac) return;
+  try {
+    hz.forEach((f, i) => {
+      const t = ac.currentTime + i * 0.1, o = ac.createOscillator(), g = ac.createGain();
