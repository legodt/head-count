+/* ---------------- clicker display ----------------
+   The clicker is dumb by design: it counts nothing and knows nothing. If it has
+   a screen, the host fills it, so the number on the door matches the number in
+   the app by construction rather than by two tallies agreeing.
+
+   Uplink stays HID and is untouched - keys must never depend on this working.
+   This is a separate, optional downlink over a custom GATT characteristic, and
+   everything here is wrapped: no Web Bluetooth (iOS, every Safari) means the
+   button never appears and the app behaves exactly as it did before.
+
+   Packet, little-endian, <= 107 bytes so it clears one default-MTU negotiation:
+     0     version (1)
+     1     flags, bit 0 = session live
+     2-3   occupancy   int16, signed - negative is legal here
+     4-5   peak        int16
+     6-7   lo          int16, what series value 0 means
+     8-9   hi          int16, what series value 255 means
+     10    n, series length
+     11..  series, n bytes, occupancy resampled to even time columns
+   The device scales the series to its own panel, so a bigger screen needs no
+   protocol change. */
+
+const LINK_SVC = '48ea0001-6b75-4b1b-9c3b-1a2c4d5e6f70';
+const LINK_CHR = '48ea0002-6b75-4b1b-9c3b-1a2c4d5e6f70';
+const LINK_COLS = 96;
+
+let link = null, linkTick = null;
+
+// Occupancy resampled onto LINK_COLS even time columns. Step semantics, like the
+// chart: occupancy holds flat between taps, so each column takes the running
+// value as at its right-hand edge.
+function linkSeries(s) {
+  const out = new Array(LINK_COLS).fill(0);
+  if (!s.ev.length) return { series: out, lo: 0, hi: 0 };
+  const t0 = s.startedAt || s.ev[0][0], t1 = Math.max(s.endedAt || Date.now(), t0 + 1);
+  const occ = [];
+  let run = 0, j = 0;
+  for (let c = 0; c < LINK_COLS; c++) {
+    const edge = t0 + (t1 - t0) * (c + 1) / LINK_COLS;
+    while (j < s.ev.length && s.ev[j][0] <= edge) run += s.ev[j++][1];
+    occ.push(run);
+  }
+  const lo = Math.min(0, ...occ), hi = Math.max(...occ);
+  const span = hi - lo || 1;
+  return { series: occ.map(v => Math.round((v - lo) / span * 255)), lo, hi };
+}
+
+function linkPacket(s) {
+  const { series, lo, hi } = linkSeries(s);
+  const buf = new ArrayBuffer(11 + series.length), dv = new DataView(buf);
+  dv.setUint8(0, 1);
+  dv.setUint8(1, s.endedAt ? 0 : 1);
+  dv.setInt16(2, fold(s).occ, true);
+  dv.setInt16(4, fold(s).peak, true);
+  dv.setInt16(6, lo, true);
+  dv.setInt16(8, hi, true);
+  dv.setUint8(10, series.length);
+  series.forEach((v, i) => dv.setUint8(11 + i, v));
+  return buf;
+}
+
+async function linkPush() {
+  if (!link) return;
+  try { await link.writeValueWithoutResponse(linkPacket(S)); }
+  catch { linkDrop(); }                 // out of range, or the user turned it off
+}
+
+function linkDrop() {
+  clearInterval(linkTick); linkTick = null; link = null;
+  const b = $('btnLink');
+  if (b) { b.textContent = 'Clicker'; b.classList.remove('on'); }
+}
+
+// Must be called from a real gesture - Web Bluetooth refuses otherwise.
+async function linkConnect() {
+  if (link) { linkDrop(); toast('Clicker display disconnected'); return; }
+  try {
+    const dev = await navigator.bluetooth.requestDevice({ filters: [{ services: [LINK_SVC] }] });
+    dev.addEventListener('gattserverdisconnected', linkDrop);
+    const gatt = await dev.gatt.connect();
+    link = await (await gatt.getPrimaryService(LINK_SVC)).getCharacteristic(LINK_CHR);
+    const b = $('btnLink');
+    if (b) { b.textContent = 'Clicker ✓'; b.classList.add('on'); }
+    linkPush();
+    linkTick = setInterval(() => { if (!document.hidden) linkPush(); }, 1000);
+    toast('Clicker display connected');
+  } catch { link = null; }              // cancelled the picker, or it was not there
+}
 
